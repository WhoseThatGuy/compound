{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.compoundgym.nz"
        }
      ],
      "destination": "https://compoundgym.nz/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.compoundgym.nz"
        }
      ],
      "destination": "https://compoundgym.nz/:path*",
      "permanent": true
    },
    {
      "source": "/book-gym-tour",
      "destination": "/contact",
      "permanent": true
    },
